{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/motion/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mulish|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Mulish, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AwardItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:result|project|award|year|key|ref|className|style|children)$/]",
        "message": "<AwardItem> doesn't accept that prop. Declared props: result, project, award, year."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackToTop'] > JSXAttribute > JSXIdentifier[name!=/^(?:showAfter|label|key|ref|className|style|children)$/]",
        "message": "<BackToTop> doesn't accept that prop. Declared props: showAfter, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|ink|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'ink' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|uppercase|withArrow|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, uppercase, withArrow, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|key|ref|className|style|children)$/]",
        "message": "<CarouselSlide> doesn't accept that prop. Declared props: src, alt, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|beforeLabel|afterLabel|beforeAlt|afterAlt|start|ratio|height|safeRight|children|key|ref|className|style|children)$/]",
        "message": "<CompareSlider> doesn't accept that prop. Declared props: before, after, beforeLabel, afterLabel, beforeAlt, afterAlt, start, ratio, height, safeRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dot|tone|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label, dot, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<Divider> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dot|tone|as|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, dot, tone, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|muted|ink|inverse)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'muted' | 'ink' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<FactRow> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|radius|zoom|shadow|caption|meta|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: src, alt, ratio, radius, zoom, shadow, caption, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Figure> radius must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|options|allLabel|onChange|key|ref|className|style|children)$/]",
        "message": "<FilterSelect> doesn't accept that prop. Declared props: name, value, options, allLabel, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|title|meta|href|inset|key|ref|className|style|children)$/]",
        "message": "<HeroSlide> doesn't accept that prop. Declared props: src, title, meta, href, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='BaseField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|boxed|className|key|ref|className|style|children)$/]",
        "message": "<BaseField> doesn't accept that prop. Declared props: label, boxed, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|size|accentFirst|separator|key|ref|className|style|children)$/]",
        "message": "<MetaList> doesn't accept that prop. Declared props: items, tone, size, accentFirst, separator."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<MetaList> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaList'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<MetaList> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|panel|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href, panel."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|name|role|studio|href|key|ref|className|style|children)$/]",
        "message": "<PersonCard> doesn't accept that prop. Declared props: src, alt, name, role, studio, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|title|discipline|sector|region|year|location|category|ratio|visualisation|badge|showView|href|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: src, alt, title, discipline, sector, region, year, location, category, ratio, visualisation, badge, showView, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|author|role|tone|size|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, author, role, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<Quote> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<Quote> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UseInViewOptions'] > JSXAttribute > JSXIdentifier[name!=/^(?:threshold|rootMargin|once|key|ref|className|style|children)$/]",
        "message": "<UseInViewOptions> doesn't accept that prop. Declared props: threshold, rootMargin, once."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|description|items|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: index, title, description, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|title|legend|networks|key|ref|className|style|children)$/]",
        "message": "<ShareRow> doesn't accept that prop. Declared props: url, title, legend, networks."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|suffix|align|tone|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, suffix, align, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<StatBlock> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse)$/]",
        "message": "<StatBlock> tone must be one of 'default' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|solid|count|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, active, solid, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|label|message|key|ref|className|style|children)$/]",
        "message": "<WhatsAppButton> doesn't accept that prop. Declared props: phone, label, message."
      }
    ]
  },
